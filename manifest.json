{
  "manifest_version": 2,
  "name": "Daily Opener",
  "version": "2.0.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "{bc3bbc92-0175-4c6c-be8d-6c583b5e7837}",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },

  "description": "Set times to open tabs only once daily",
  "homepage_url": "https://github.com/edward-qin/daily_opener_extension",
  "icons": {
    "48": "icons/main_icon-48.png",
    "128": "icons/main_icon-128.svg"
  },

  "permissions": ["storage", "alarms", "tabs"],

  "browser_action": {
    "default_icon": "icons/main_icon.svg",
    "default_title": "Daily Opener",
    "default_popup": "src/popup/input_urls.html"
  },

  "background": {
    "page": "src/background/background.html",
    "persistent": false
  }
  
}
